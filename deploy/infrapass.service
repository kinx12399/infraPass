[Unit]
Description=InfraPass FastAPI
After=network-online.target
Wants=network-online.target

[Service]
User=infrapass
Group=infrapass
WorkingDirectory=/opt/infrapass
EnvironmentFile=/etc/infrapass.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/infrapass/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers 2 --no-proxy-headers
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0027

[Install]
WantedBy=multi-user.target
