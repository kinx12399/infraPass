[Unit]
Description=InfraPass FastAPI
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/infraPass
EnvironmentFile=/home/ubuntu/infraPass/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/infraPass/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers 2 --no-proxy-headers
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
